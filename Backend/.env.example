# Chép file này thành .env rồi điền giá trị. Không commit .env.
PORT=3000
NODE_ENV=development

# PostgreSQL
# - Docker (docker compose up -d db): postgresql://postgres:postgres@localhost:5432/travelplan
# - Neon (production): chuỗi kết nối lấy trên trang Neon, có ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travelplan

# JWT: chuỗi ngẫu nhiên dài, mỗi môi trường một giá trị khác nhau
JWT_SECRET=doi-chuoi-nay
JWT_EXPIRES_IN=24h

# Các origin frontend được gọi API, cách nhau bởi dấu phẩy (để trống khi dev = cho phép tất cả)
CORS_ORIGINS=http://localhost:8080,http://localhost:5500,http://127.0.0.1:5500

# Gửi email đặt lại mật khẩu (UC 4)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Gemini (tuỳ chọn, gợi ý lịch trình bằng AI)
GEMINI_API_KEY=
